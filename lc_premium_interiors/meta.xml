<meta>
    <info author="gta4gg" name="lc_premium_interiors"
          description="GTA V-style luxury boutique, LCPD precinct, mechanic workshop and public gym - private interiors for Liberty City"
          type="script" version="1.0.0"/>

    <min_mta_version server="1.6.0-9.22470" client="1.6.0-9.22470"/>

    <!-- dependencies: economy/inventory/DB are used for real purchases -->
    <include resource="ng-economy"/>
    <include resource="ng-inventory"/>
    <include resource="ng-database"/>

    <!-- shared venue/dimension/asset configuration -->
    <script src="config.lua" type="shared" cache="false"/>

    <!-- authoritative teleports, purchases, gym rewards and service bridges -->
    <script src="server/s_main.lua" type="server" cache="false"/>

    <!-- custom-ID asset loader, private rooms and pure-DX interface -->
    <script src="client/c_main.lua" type="client" cache="false"/>

    <!-- GTA V Online Eclipse Tower apartment (LCPD detective bureau) -->
    <file src="models/apt_mp_shell.dff"/>
    <file src="models/apt_mp_mod.txd"/>
    <file src="models/apt_mp_shell.col"/>
    <file src="models/apt_mp_int.dff"/>
    <file src="models/apt_mp_int.txd"/>
    <file src="models/apt_mp_int.col"/>
    <file src="models/apt_mp_props.dff"/>
    <file src="models/apt_mp_props.txd"/>
    <file src="models/apt_mp_props.col"/>

    <!-- Otaku Shop Interior (boutique) -->
    <file src="models/Otakushop.dff"/>
    <file src="models/Otakushop.txd"/>
    <file src="models/Otakushop.col"/>
    <file src="models/Otaku1.dff"/>
    <file src="models/Otaku2.dff"/>
    <file src="models/Otaku3.dff"/>
    <file src="models/Otaku4.dff"/>

    <!-- Car Mechanic Simulator (workshop) -->
    <file src="models/mech_outer.dff"/>
    <file src="models/mech_door.dff"/>
    <file src="models/mech.txd"/>
    <file src="models/mech.col"/>

    <!-- Interior of the Sports Hall (public gym) -->
    <file src="models/gym_hall.dff"/>
    <file src="models/gym_hall.txd"/>
    <file src="models/gym_hall.col"/>

    <!-- documentation (client download not required) -->
    <file src="README.md" download="false"/>
</meta>
